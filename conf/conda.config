/*
 * Centralized Conda Environment Configuration
 *
 * This file defines all conda environments used across the pipeline.
 * Environments are grouped by tool/purpose for easier maintenance.
 */

process {
    // ==========================================================================
    // PYTHON BASE ENVIRONMENTS
    // ==========================================================================
    // Simple Python 3.9 for lightweight scripts
    withName: 'COUNT_REGIONS|TABULATE_REGIONS|AGGREGATE_TAXONOMY|CREATE_NAME_MAP|COLLECT_VERSIONS' {
        conda = "conda-forge::python=3.9"
    }

    // RENAME_GENOMES also runs the pepM screen, so it needs the screen's tools.
    // It was left on the python-only environment above at first, and the result
    // was not an error: the screen fell back to "screening by DNA", found nothing,
    // and reported every genome as pepM-negative. pepm_prescreen.py now exits on
    // ImportError rather than degrading, so that particular silence cannot recur.
    withName: 'RENAME_GENOMES' {
        conda = "conda-forge::python=3.9 conda-forge::biopython bioconda::diamond"
    }

    // Python with SQLite for database operations
    withName: 'CLUSTERING_STATS' {
        conda = "conda-forge::sqlite conda-forge::python=3.9"
    }

    // Python with pandas for data processing
    withName: 'EXTRACT_GCF_REPRESENTATIVES' {
        conda = "conda-forge::python=3.9 conda-forge::pandas"
    }

    // ==========================================================================
    // BIOINFORMATICS TOOLS
    // ==========================================================================
    // antiSMASH for BGC detection
    withName: 'GET_ANTISMASH_VERSION|ANTISMASH|DOWNLOAD_ANTISMASH_DBS' {
        conda = "bioconda::antismash"
    }

    // BiG-SCAPE for GCF clustering (pinned pyhmmer for compatibility)
    withName: 'BIGSCAPE' {
        conda = "bioconda::bigscape 'bioconda::pyhmmer<0.11'"
    }

    withName: 'BIGSCAPE_PARTITION' {
        conda = "bioconda::bigscape 'bioconda::pyhmmer<0.11'"
    }

    withName: 'BIGSCAPE_CENTERS' {
        conda = "bioconda::bigscape 'bioconda::pyhmmer<0.11'"
    }

    withName: 'BIGSCAPE_REFERENCES' {
        conda = "bioconda::bigscape 'bioconda::pyhmmer<0.11'"
    }

    // GTDB-Tk for phylogenetic classification
    withName: 'GTDBTK_CLASSIFY' {
        conda = "python=3.10 bioconda::gtdbtk=2.6.1"
    }

    // GTDB-Tk database download (with aria2 for parallel downloads)
    withName: 'DOWNLOAD_GTDBTK_DB' {
        conda = "python=3.10 conda-forge::aria2 bioconda::gtdbtk=2.6.1"
    }

    // Taxonomy processing
    withName: 'EXTRACT_TAXONOMY' {
        conda = "bioconda::taxonkit conda-forge::biopython"
    }

    withName: 'DOWNLOAD_TAXONKIT_DB' {
        conda = "bioconda::taxonkit conda-forge::wget conda-forge::unzip"  // unzip: the dated taxdump archive is .zip, not .tar.gz
    }

    // ==========================================================================
    // SEQUENCE PROCESSING
    // ==========================================================================
    // BioPython for GenBank/FASTA operations
    withName: 'GENBANK_TO_FASTA' {
        conda = "conda-forge::biopython"
    }

    // GTDB-Tk result filtering (requires pandas + biopython)
    withName: 'FILTER_GTDBTK_RESULTS' {
        conda = "conda-forge::python=3.9 conda-forge::pandas conda-forge::biopython"
    }

    // ==========================================================================
    // DATABASE DOWNLOADS
    // ==========================================================================
    // NCBI datasets CLI
    withName: 'NCBI_DATASETS_DOWNLOAD' {
        conda = "conda-forge::ncbi-datasets-cli conda-forge::unzip"
    }

    // Pfam database (HMMER)
    withName: 'DOWNLOAD_PFAM' {
        conda = "bioconda::hmmer conda-forge::wget"
    }

    // ==========================================================================
    // VISUALIZATION
    // ==========================================================================
    // Full visualization environment
    withName: 'VISUALIZE_RESULTS' {
        conda = "conda-forge::python=3.9 conda-forge::pandas conda-forge::matplotlib conda-forge::seaborn conda-forge::numpy conda-forge::biopython"
    }


    // GCF biosynthetic tree (needs scipy for hierarchical clustering + biopython for tree pruning)
    withName: 'PARTITION_BGCS' {
        // hmmsearch/hmmalign against PF13714, plus biopython to read the region
        // GenBanks — this runs before BiG-SCAPE, so there is no database to
        // read pepM sequences out of.
        conda = "conda-forge::python=3.9 conda-forge::numpy conda-forge::biopython bioconda::hmmer"
    }

    withName: 'PEPM_MAKEDB|PEPM_PRESCREEN' {
        // diamond does the search, biopython parses the GenBank records
        conda = "conda-forge::python=3.9 conda-forge::biopython bioconda::diamond"
    }

    withName: 'BUILD_PROTEIN_POOL' {
        conda = "conda-forge::python=3.9 conda-forge::biopython"
    }

    withName: 'RECOVER_ORFS' {
        // prodigal calls ORFs de novo, diamond recovers what it truncates,
        // biopython reads the GenBanks and squares hits to codon boundaries
        conda = "conda-forge::python=3.9 conda-forge::biopython bioconda::prodigal bioconda::diamond"
    }

    withName: 'BIOSYNTHETIC_PROFILE' {
        // sqlite3 and the curated domain map only -- no aligner, no hmmer.
        conda = "conda-forge::python=3.9"
    }

    withName: 'BRANCH_POINT_PREDICTION' {
        // hmmer builds and searches the per-class profiles; biopython reads the
        // region GenBanks for domains
        conda = "conda-forge::python=3.9 conda-forge::biopython bioconda::hmmer"
    }

    withName: 'GCF_ANNOTATION_TRANSFER' {
        // diamond groups orthologues within each family; biopython reads the
        // region GenBanks, which is where product names live (BiG-SCAPE's
        // database stores sequences and domains but no products).
        conda = "conda-forge::python=3.9 conda-forge::biopython bioconda::diamond"
    }

    withName: 'MERGE_BIGSCAPE' {
        conda = "conda-forge::python=3.9"
    }

    withName: 'PEPM_ALL_BY_ALL' {
        // hmmer is back for this one process: the pepM alignment is built with
        // hmmalign against PF13714, which is what makes identity comparable to
        // the paper's MSA-with-pairwise-deletion rather than a BLAST HSP.
        conda = "conda-forge::python=3.9 conda-forge::numpy conda-forge::matplotlib bioconda::hmmer"
    }

    withName: 'GCF_BIOSYNTHETIC_TREE' {
        conda = "conda-forge::python=3.9 conda-forge::pandas conda-forge::matplotlib conda-forge::scipy conda-forge::numpy conda-forge::biopython"
    }

}
