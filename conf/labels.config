/*
 * Process Labels Configuration
 *
 * Defines resource allocations and error handling for labeled processes.
 * Labels provide a clean separation between process logic and resource requirements.
 */

process {
    // ==========================================================================
    // RESOURCE LABELS
    // ==========================================================================

    // Local execution (no resources needed, runs on head node)
    withLabel: 'process_local' {
        executor = 'local'
        cpus = 1
        memory = '1 GB'
    }

    // Low resource processes (Python scripts, simple operations)
    // 12h, not 1h. The 1h default killed NCBI_FETCH_METADATA 60 minutes into the
    // GenBank Enterobacterales run (exit 143, SIGTERM) while its download was still
    // progressing -- 531 MB of the ~558 MB that taxon needs, at 144 kB/s sustained.
    // NCBI builds a dehydrated package for 1,349,507 records server-side, so the rate
    // is set by that work rather than by the link, which measures 72 MB/s here.
    //
    // `retry_on_error` lists 143 and should have absorbed it. It did not: Nextflow
    // threw IllegalThreadStateException("process hasn't exited") reaping the killed
    // process and aborted the session before the retry ran, reporting `failed=0` on a
    // run that died. So the time limit has to be generous enough not to fire, because
    // the retry cannot be relied on to catch it when it does.
    //
    // This raises it for all 23 process_low tasks, which does weaken the limit's
    // ability to catch a genuinely hung light task -- accepted deliberately. Most of
    // them are seconds-long and would need to hang 12h to notice the difference.
    withLabel: 'process_low' {
        cpus = 1
        memory = '2 GB'
        time = '12h'
    }

    // Medium resource processes (antiSMASH, data processing)
    withLabel: 'process_medium' {
        cpus = 4
        memory = '8 GB'
        time = '2h'
    }

    // High resource processes (BiG-SCAPE clustering)
    withLabel: 'process_high' {
        cpus = 8
        memory = '32 GB'
        time = '8h'
    }

    // High memory processes (GTDB-Tk pplacer)
    // Default to 48 GB for local/workstation - SLURM profile overrides to 128 GB
    withLabel: 'process_high_memory' {
        cpus = 8
        memory = '48 GB'
        time = '24h'
    }

    // ==========================================================================
    // ERROR HANDLING LABELS
    // ==========================================================================

    // Tolerant processes - individual failures don't stop the pipeline
    // Used for per-genome processes where some failures are expected
    withLabel: 'tolerant' {
        errorStrategy = 'ignore'
    }

    // Retry on transient errors (network issues, temporary failures)
    withLabel: 'retry_on_error' {
        errorStrategy = { task.exitStatus in [1, 143, 137, 104, 134, 139] ? 'retry' : 'finish' }
        maxRetries = 3
    }

    // ==========================================================================
    // PER-PROCESS RESOURCE OVERRIDES
    // ==========================================================================

    // antiSMASH — measured over 950 genomes (Erwiniaceae benchmark, 2026-06):
    // %cpu p50 = 117%, p99 = 145% (no task ever used 2 full cores) and peak RSS
    // p90 = 1.2 GB, p99 = 4.7 GB. The process_medium default (4 CPUs / 8 GB) was
    // ~4x over-allocated, which throttles how many genomes run concurrently.
    // 13/950 genomes exceeded 4 GB, so memory escalates once on an OOM kill before
    // falling back to the 'tolerant' behaviour of skipping the genome.
    // Exit 1 is in the retry list because of a startup race, not because antiSMASH
    // failing cleanly deserves a second go: on a fresh run Nextflow launches tasks
    // while conda is still materialising the env, and antiSMASH reads a half-written
    // HMM ("File exists, but appears to be empty?") and exits 1. Measured on the
    // 2026-09-07 Erwiniaceae run: 3 of 2,772 genomes lost this way, all within a
    // six-second window, every task afterwards fine. A genuinely broken genome costs
    // one extra attempt and is then skipped as before.
    withName: 'ANTISMASH' {
        cpus = 2
        memory = { 6.GB * task.attempt }
        // Batched: params.antismash_batch_size genomes run sequentially in one task,
        // so the 2 h process_medium default no longer fits. At 50 genomes the mean is
        // ~35 min, but per-genome runtime spans 6.2x across size bins and the batch
        // is only as fast as its slowest members.
        time = '8h'
        maxRetries = 1
        errorStrategy = { task.exitStatus in [1, 104, 134, 137, 139, 140, 143] && task.attempt <= 1 ? 'retry' : 'ignore' }
    }
}
