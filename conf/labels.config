/*
 * Process Labels Configuration
 *
 * Defines resource allocations and error handling for labeled processes.
 * Labels provide a clean separation between process logic and resource requirements.
 */

process {
    // ==========================================================================
    // RESOURCE LABELS
    // ==========================================================================

    // Local execution (no resources needed, runs on head node)
    withLabel: 'process_local' {
        executor = 'local'
        cpus = 1
        memory = '1 GB'
    }

    // Low resource processes (Python scripts, simple operations)
    // 12h, not 1h. The 1h default killed NCBI_FETCH_METADATA 60 minutes into the
    // GenBank Enterobacterales run (exit 143, SIGTERM) while its download was still
    // progressing -- 531 MB of the ~558 MB that taxon needs, at 144 kB/s sustained.
    // NCBI builds a dehydrated package for 1,349,507 records server-side, so the rate
    // is set by that work rather than by the link, which measures 72 MB/s here.
    //
    // `retry_on_error` lists 143 and should have absorbed it. It did not: Nextflow
    // threw IllegalThreadStateException("process hasn't exited") reaping the killed
    // process and aborted the session before the retry ran, reporting `failed=0` on a
    // run that died. So the time limit has to be generous enough not to fire, because
    // the retry cannot be relied on to catch it when it does.
    //
    // This raises it for all 23 process_low tasks, which does weaken the limit's
    // ability to catch a genuinely hung light task -- accepted deliberately. Most of
    // them are seconds-long and would need to hang 12h to notice the difference.
    withLabel: 'process_low' {
        cpus = 1
        memory = '2 GB'
        time = '12h'
    }

    // Medium resource processes (antiSMASH, data processing)
    withLabel: 'process_medium' {
        cpus = 4
        memory = '8 GB'
        time = '2h'
    }

    // High resource processes (the four BiG-SCAPE steps: BIGSCAPE, _REFERENCES,
    // _CENTERS, _PARTITION).
    //
    // 12 GB rather than 32, for the same reason as process_high_memory above: this
    // is the no-profile default and 32 GB is a machine spec in disguise. 12 GB on
    // the tree-PSS fit GB = 1.80 + 2.04e-7*n^2 holds ~7,000 BGCs in one job and
    // gives PARTITION_BGCS a cap of ~6,400 at the 0.85 margin, which covers both
    // target taxa (Enterobacterales GenBank yielded 1,476 BGCs; Actinomycetes
    // projects to 1,000-4,000).
    //
    // The SLURM profile restores 32 GB explicitly, so the cluster is unchanged --
    // important for PARTITION_BGCS in particular, whose cap follows its allocation
    // (11,158 BGCs at 32 GB against 6,416 at 12).
    withLabel: 'process_high' {
        cpus = 8
        memory = '12 GB'
        time = '8h'
    }

    // High memory processes (GTDB-Tk pplacer). GTDB-Tk is the ONLY member.
    //
    // 12 GB here is a FLOOR FOR A LABEL WITH NO EFFECTIVE MEMBER. GTDB-Tk is its only
    // member and takes 48 GB by name below, and a withName beats every withLabel in
    // every profile -- so this value reaches nothing today. It is kept so the default
    // layer stays admittable on a small machine if a second member is ever added.
    //
    // The 4 GB that justified cutting this from 48 was NOT a sampling error, which is
    // what commits b7b96a7 and a858d13 claimed. It was correct for the configuration
    // it measured: `--skip_ani_screen` was hardcoded in modules/phylogeny/gtdbtk.nf
    // from the initial release until b99b0b1 (2026-10-08), so the RefSeq run had NO
    // skani stage at all -- and skani is the stage that owns the memory peak.
    // gtdbtk_headroom/ corroborates from the other side: its pplacer-only phase ran
    // at 3 of 56 GB. So the 48 was right, the 12 was right for a configuration the
    // pipeline abandoned on 2026-10-08, and nothing was mis-sampled.
    // See docs/comparisons/enterobacterales_refseq/disk_samples.tsv for that run.
    //
    // SLURM's profile raises this label to 128 GB on the highmem queue, but GTDB-Tk
    // no longer sees it, for the same withName-beats-withLabel reason: it requests
    // 48 GB on the cluster too. That is a deliberate REDUCTION from 128 -- 48 is the
    // measured figure plus headroom -- and it matters because slurm enforces memory
    // as a cgroup where the old 128 GB was simply slack.
    withLabel: 'process_high_memory' {
        cpus = 8
        memory = '12 GB'
        time = '24h'
    }

    // ==========================================================================
    // ERROR HANDLING LABELS
    // ==========================================================================

    // Tolerant processes - individual failures don't stop the pipeline
    // Used for per-genome processes where some failures are expected
    withLabel: 'tolerant' {
        errorStrategy = 'ignore'
    }

    // Retry on transient errors (network issues, temporary failures)
    withLabel: 'retry_on_error' {
        errorStrategy = { task.exitStatus in [1, 143, 137, 104, 134, 139] ? 'retry' : 'finish' }
        maxRetries = 3
    }

    // ==========================================================================
    // PER-PROCESS RESOURCE OVERRIDES
    // ==========================================================================

    // GTDB-Tk — 48 GB, measured, and NOT the process_high_memory default.
    //
    // Its real peak is ~37 GiB, nine times the 4 GB this repo claimed until
    // 2026-11-03. That 4 GB came from a 60-second sampler; the peak is a ~30-second
    // spike, so the old sampling walked straight through it. Measured three ways at
    // 5 s and 2 s on the 2026-11-03 Erwiniaceae run and a standalone replicate:
    // PSS 36.8 GiB, system mem_used 38.8 GiB (MemAvailable fell 56.9 -> 18.1), and
    // Nextflow's own peak_rss 36.9 GB. PSS divides shared pages by the number of
    // processes mapping them, so it cannot double-count a forked tree -- and here it
    // equals RSS, meaning the memory is genuinely resident. (Contrast BIGSCAPE,
    // whose peak_rss of 16 GB really IS a summing artifact: 21 workers sharing one
    // Pfam database, PSS 2.9 GiB.)
    //
    // Sharding cannot bring it down, in COUNT or in DIVERSITY. Measured standalone,
    // same genomes, flags and database, ANI screen on, against release226:
    //
    //   count, all Erwiniaceae      25 ->  10.67 GiB,  25 min
    //                              100 ->  34.44 GiB,  27 min
    //                              300 ->  36.22 GiB,  27 min
    //   diversity, 300 genomes       1 family  -> 36.3 GiB,  0h27m
    //                                8 families-> 38.2 GiB,  2h07m
    //                               29 phyla   -> 38.2 GiB, >5h02m (stopped)
    //
    // Memory saturates by ~100 genomes and is then FLAT across diversity -- 36.3 to
    // 38.2 GiB from one family to 29 phyla. So 48 GB holds for every planned run and
    // a smaller gtdbtk_shard_size buys nothing: 5000 -> 300 saves nothing at all, and
    // 5000 -> 25 would save 26 GiB at 12x the shards, each paying the ANI screen's
    // ~27-35 min fixed cost over all 143,614 reference genomes.
    //
    // The two costs sit in DIFFERENT STAGES, which is why one is flat and one is not.
    // Memory is the all-vs-all ANI screen: every arm's peak falls inside the ANI
    // window and BEFORE the first pplacer starts, and the one-family arm ran ZERO
    // pplacer invocations yet still peaked at 36.3 GiB. (It saturates rather than
    // being strictly fixed -- 25 genomes cost 10.67 GiB -- so the plateau is what is
    // established, not a constant reference load.) TIME is pplacer, which is
    // memory-cheap because --scratch_dir spills to disk, and GTDB-Tk 2.x places
    // against a split reference -- one backbone plus 8 class-level subtrees, pplacer
    // once per subtree holding queries -- so breadth sets how many traversals happen.
    // Arm C's runs: backbone 7m, then 1h17m, 8m, 1h01m, 1h27m.
    //
    // DO NOT read the diversity arms as a runtime forecast. They round-robin across
    // families, which oversamples rare lineages, so their tree-path genomes are
    // maximally novel. For a real-run estimate use
    // docs/comparisons/gtdbtk_ani_screen_genbank/: 450 actual GenBank Enterobacterales
    // genomes, 44 min, 5.3% ANI fall-through.
    //
    // Declaring the true figure also fixes a concurrency hazard for free. There is no
    // maxForks here, so admission is memory arithmetic: at the old 16 GB a 57 GB box
    // admitted THREE shards demanding ~110 GiB, which any run over
    // gtdbtk_shard_size genomes would have triggered -- Enterobacterales and the
    // million-genome target both do. At 48 GB the same arithmetic yields one.
    //
    // The cost is honest: GTDB-Tk cannot run on a machine under ~52 GB. It fails at
    // ADMISSION with a clear message rather than being OOM-killed mid-placement, and
    // main.nf warns before anything runs. Set run_gtdbtk = false on a smaller box.
    //
    // WHY 48 AND NOT 40. The peak is 38.8 GiB, so 40 GiB would leave 3% headroom on
    // a ~30-second spike measured on one host against one GTDB release -- and the
    // figure is set by the SIZE OF THE REFERENCE DATA, which release 232 (already
    // flagged as available by the run's own database notice) would change. 48 GiB
    // gives 24%. On the local executor this only moves admission, but the slurm
    // profile enforces `memory` as a cgroup, where 3% is an OOM kill. 48 GB is also
    // what the profile asked for BEFORE the 2026-11-02 "correction" to 16: that
    // original figure was right, and the correction was the error.
    //
    // INDEPENDENTLY CONFIRMED, and this was in the repo first:
    // docs/comparisons/gtdbtk_headroom/ measured 38 of 56 GB of SYSTEM RAM in skani
    // over 2,530 genomes -- the same instrument and the same figure as the 38.2 GiB
    // measured here over 300, an independent reproduction 8x further out. (Its 41.7
    // figure is total Pss in MiB: 42,737 MiB = 41.74 GiB, as that file's own
    // scratch_mb 95,716 -> "93.5 GB" proves. Commits b7b96a7 and a858d13 misread it
    // as decimal GB and claimed it equalled 38.8 GiB -- a cross-basis comparison,
    // which is the memory-side version of the CPU-basis rule. Note 41.74 GiB
    // ALREADY EXCEEDS 40 GB, which is the sounder reason for 48.) It also recorded
    // that the peak is "set by sketching GTDB's 143,614 REFERENCE genomes" and
    // "the genuine memory ceiling ... at any input size". It also recorded pplacer's
    // 54.2 GB PSS and explained it as the file-backed scratch mapping rather than a
    // requirement. The 4 GB figure therefore contradicted a committed comparison in
    // this repo for two months. What the 2026-11-03 work adds is the DIVERSITY
    // dimension (headroom varied only count) and the pplacer-per-subtree time model.
    //
    // The one-family caveat this comment carried on 2026-11-03 is now discharged:
    // the diversity arms above hold 300 genomes fixed and span 8 families and then
    // 29 phyla, including 23 Actinomycetota, and memory does not move. Arm C covers
    // 29 of the 57 phyla in the Bacteria pilot's map, so a diversity effect on memory
    // is disfavoured rather than excluded. Full measurements and caveats:
    // docs/comparisons/gtdbtk_memory_scaling/.
    withName: 'GTDBTK_CLASSIFY' {
        memory = '48 GB'
        // 72h, not the 24h inherited from process_high_memory. Neither profile
        // overrides `time` -- local sets only memory, slurm only queue and memory --
        // and this process declares no errorStrategy and carries no retry label, so a
        // time kill terminates the RUN with the whole antiSMASH phase already paid
        // for. Two figures bracket it and they disagree in form, so take the larger:
        // the only completed Bacteria-wide shard in the repo measured 8h43m51s
        // (docs/comparisons/bacteria_reference_pilot/pipeline_trace.tsv), while
        // docs/comparisons/gtdbtk_scaling/ projects 52.9 h for a full 5,000-genome
        // shard from a slope fitted at N=8 and N=64. The 2026-11-03 arms contradict
        // that slope's SHAPE -- cost tracks the number of distinct classes traversed,
        // not the query count: 7 queries cost 9 min while 2 cost 88 -- which implies
        // a ceiling nearer 9-10 h (one backbone plus at most 8 class-level subtrees
        // at ~1 h each, plus the ANI screen). But a projection this run cannot
        // falsify is not worth a killed 50-hour task, so 72h clears both.
        time = '72h'
    }

    // antiSMASH — measured over 950 genomes (Erwiniaceae benchmark, 2026-06):
    // %cpu p50 = 117%, p99 = 145% (no task ever used 2 full cores) and peak RSS
    // p90 = 1.2 GB, p99 = 4.7 GB. The process_medium default (4 CPUs / 8 GB) was
    // ~4x over-allocated, which throttles how many genomes run concurrently.
    // 13/950 genomes exceeded 4 GB, so memory escalates once on an OOM kill before
    // falling back to the 'tolerant' behaviour of skipping the genome.
    // Exit 1 is in the retry list because of a startup race, not because antiSMASH
    // failing cleanly deserves a second go: on a fresh run Nextflow launches tasks
    // while conda is still materialising the env, and antiSMASH reads a half-written
    // HMM ("File exists, but appears to be empty?") and exits 1. Measured on the
    // 2026-09-07 Erwiniaceae run: 3 of 2,772 genomes lost this way, all within a
    // six-second window, every task afterwards fine. A genuinely broken genome costs
    // one extra attempt and is then skipped as before.
    withName: 'ANTISMASH' {
        cpus = 2
        // Required because executor.cpus is oversubscribed to 32 (see nextflow.config).
        // antiSMASH genuinely uses its cores -- measured %cpu p99 = 145% -- so without
        // this it would admit 16 tasks at 2 cpus against 16 real cores and thrash.
        // 7 x 2 = 14 cores, leaving headroom for the fetch tasks running alongside.
        maxForks = 7
        memory = { 6.GB * task.attempt }
        // Batched: params.antismash_batch_size genomes run sequentially in one task,
        // so the 2 h process_medium default no longer fits. At 50 genomes the mean is
        // ~35 min, but per-genome runtime spans 6.2x across size bins and the batch
        // is only as fast as its slowest members.
        time = '8h'
        maxRetries = 1
        errorStrategy = { task.exitStatus in [1, 104, 134, 137, 139, 140, 143] && task.attempt <= 1 ? 'retry' : 'ignore' }
    }

    // FETCH_RENAME_SCREEN — 1 CPU, not process_medium's 4. Measured on the GenBank
    // Enterobacterales run over 919 batches: mean %cpu 90.7, i.e. each task uses 0.91
    // of ONE core while reserving four. On a 16-core box that put the local executor
    // at exactly 4 concurrent tasks, so `download_max_forks` could not raise
    // concurrency no matter what it was set to -- the CPU budget was the real limit
    // and it was invisible, because nothing reports "you asked for 4x what you use".
    //
    // The task is about half network-wait, which consumes no CPU at all, so single-
    // core tasks overlap fetching against screening instead of blocking on a
    // reservation. Probed alongside the live run (bench/fork_probe.sh): aggregate
    // throughput went 11 -> 56 MB/s moving from 4 to 8 concurrent streams, with 0
    // failures in 102 batches, and 12 streams gained nothing further (55 MB/s) -- the
    // link saturates at ~55 MB/s. So concurrency is worth raising and the ceiling is
    // around 8-12 fetches, which is what download_max_forks = 12 targets.
    //
    // This makes the diamond screen single-threaded via `--threads ${task.cpus}`. It
    // costs 0.2 CPU-s per annotated genome and 2.0 on the blastx path, against ~32 s
    // of task wall time, so it is not the binding term.
    //
    // NOTE the one claim here that is NOT measured: CLAUDE.md records "concurrency
    // above 2 is worse, not better" from a probe on a throttled ~264 Mbit WiFi link.
    // That link no longer exists; this box measures 72.7 MB/s on 4 curl streams. The
    // old finding was never wrong, it was just about different hardware -- re-probe
    // before carrying either number to another machine.
    withName: 'FETCH_RENAME_SCREEN' {
        cpus = 1
        // 2 GB, not process_medium's 8. THIS was the real concurrency cap and it was
        // invisible: the local executor admits tasks while BOTH cpus and memory remain
        // free, so 56 GB / 8 GB held it at SEVEN concurrent tasks no matter what
        // download_max_forks said. Raising forks 4 -> 12 -> 24 moved the measured rate
        // 134 -> 194 genomes/min and then stopped, because 12 and 24 were both capped
        // at 7. Two tuning rounds were spent on the wrong parameter.
        //
        // Measured peak_rss over 1,603 tasks: p50 0.23 GB, p90 0.38, p99 0.94, max 1.20
        // -- 8.5x over-allocated at p99. 2 GB is 1.7x the observed maximum, which leaves
        // real headroom while allowing 28 concurrent.
        //
        // When overriding `cpus` on a label-derived process, check `memory` too. The
        // executor caps on whichever runs out first and reports neither.
        memory = '2 GB'
    }

    // BUILD_PROTEIN_POOL builds the pool's DIAMOND database as well as the pool, so it
    // needs more than process_low's 1 CPU / 2 GB. `diamond makedb` peaked at 1.65 GB
    // RSS on the whole-Bacteria pilot's 6.89 GB pool -- inside 2 GB, but only just, and
    // the pool grows with every retained genome. 4 CPUs because the wall time is paid
    // once per run and 16 threads cost 1.9x the CPU for 1.4x the speed (84 s / 268
    // CPU-s against 59 s / 500).
    // memory is declared in modules/genome/recover_orfs.nf, scaled to the INPUT
    // BYTES -- a config withName closure cannot see process inputs, and setting
    // memory here would override it.
    withName: 'BUILD_PROTEIN_POOL' {
        cpus = 4
    }

    // RECOVER_ORFS needs longer than process_medium's 2h, which killed it at exactly
    // 00:53:30 -> 02:53:30 (exit 143, SIGTERM) on the whole-Bacteria reference pilot.
    // No OOM -- dmesg clean -- and the task was still progressing.
    //
    // CORRECTED 2026-10-19. This comment used to explain the cost as "the clade is
    // ~5 Mb genomes with decent annotation ... a taxonomically broad set has far more
    // unannotated CDS to call". That is backwards in both halves, and the measurement
    // behind it was taken on a failing USB disk. See
    // docs/comparisons/recover_orfs_recalibration/.
    //
    // The pool is built FROM the retained genomes, so GOOD annotation makes this stage
    // slower, not faster: GenBank Enterobacterales donated 769 proteins per retained
    // genome (64% of one batch had no annotation at all), the RefSeq reference pilot
    // 4,726. That is 2.74x the genomes but 16.8x the proteins, and 11.8x the per-genome
    // cost on identical input. Enterobacterales was cheap because its input was badly
    // annotated.
    //
    // Measured per genome against the pilot's pool: 100.5 s wall / 600.5 CPU-s with the
    // database rebuilt per genome, 46 s / 126 CPU-s with it prebuilt. At 200 genomes a
    // batch that is 5.6 h against 2.6 h -- so 2h was never going to fit either way, and
    // 12h holds with the fix in place.
    //
    // Overridden here rather than by raising process_medium globally, because 2h is a
    // correct and useful hang detector for its other members -- FETCH_RENAME_SCREEN
    // tasks run ~30-50 s, and the visualization steps are minutes. ANTISMASH already
    // carries its own 8h override for the same reason.
    //
    // Note RECOVER_ORFS has no retry label, so there was nothing to absorb the kill
    // even before Nextflow's IllegalThreadStateException race aborted the session.
    withName: 'RECOVER_ORFS' {
        time = '12h'

        // Memory is declared in modules/genome/recover_orfs.nf and scales with the
        // DIAMOND database, because a literal here would be tuned to one pool on one
        // machine. A config withName closure cannot see process inputs, so setting
        // memory here would override that closure -- hence only `time` lives here.
        //
        // What the measurement says, kept because the next person will want it:
        // diamond drives the peak and QUERY size drives diamond, not the database.
        // 0.35 MB of gaps peaks at 3.46 GB, 16 MB at 7.16, 64 MB at 7.26 -- so it
        // PLATEAUS, and a batch reaches the ceiling well before 50 genomes.
        //
        // Do NOT try to bound it by reshaping the query. Both levers were measured
        // and both CHANGE THE HITS: splitting the batch into 4 saves no memory at
        // all (7.16 GB, still past the plateau) while adding 106 hits and losing 47,
        // 78 of the additions above the script's 40% identity floor; `-b 0.02` does
        // cut memory to 0.33 GB but costs 5.5x the CPU and still moves the hit set.
        // One unsplit call is the only variant verified byte-identical to the
        // per-genome path.
    }
}
