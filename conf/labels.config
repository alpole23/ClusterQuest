/*
 * Process Labels Configuration
 *
 * Defines resource allocations and error handling for labeled processes.
 * Labels provide a clean separation between process logic and resource requirements.
 */

process {
    // ==========================================================================
    // RESOURCE LABELS
    // ==========================================================================

    // Local execution (no resources needed, runs on head node)
    withLabel: 'process_local' {
        executor = 'local'
        cpus = 1
        memory = '1 GB'
    }

    // Low resource processes (Python scripts, simple operations)
    // 12h, not 1h. The 1h default killed NCBI_FETCH_METADATA 60 minutes into the
    // GenBank Enterobacterales run (exit 143, SIGTERM) while its download was still
    // progressing -- 531 MB of the ~558 MB that taxon needs, at 144 kB/s sustained.
    // NCBI builds a dehydrated package for 1,349,507 records server-side, so the rate
    // is set by that work rather than by the link, which measures 72 MB/s here.
    //
    // `retry_on_error` lists 143 and should have absorbed it. It did not: Nextflow
    // threw IllegalThreadStateException("process hasn't exited") reaping the killed
    // process and aborted the session before the retry ran, reporting `failed=0` on a
    // run that died. So the time limit has to be generous enough not to fire, because
    // the retry cannot be relied on to catch it when it does.
    //
    // This raises it for all 23 process_low tasks, which does weaken the limit's
    // ability to catch a genuinely hung light task -- accepted deliberately. Most of
    // them are seconds-long and would need to hang 12h to notice the difference.
    withLabel: 'process_low' {
        cpus = 1
        memory = '2 GB'
        time = '12h'
    }

    // Medium resource processes (antiSMASH, data processing)
    withLabel: 'process_medium' {
        cpus = 4
        memory = '8 GB'
        time = '2h'
    }

    // High resource processes (BiG-SCAPE clustering)
    withLabel: 'process_high' {
        cpus = 8
        memory = '32 GB'
        time = '8h'
    }

    // High memory processes (GTDB-Tk pplacer)
    // Default to 48 GB for local/workstation - SLURM profile overrides to 128 GB
    withLabel: 'process_high_memory' {
        cpus = 8
        memory = '48 GB'
        time = '24h'
    }

    // ==========================================================================
    // ERROR HANDLING LABELS
    // ==========================================================================

    // Tolerant processes - individual failures don't stop the pipeline
    // Used for per-genome processes where some failures are expected
    withLabel: 'tolerant' {
        errorStrategy = 'ignore'
    }

    // Retry on transient errors (network issues, temporary failures)
    withLabel: 'retry_on_error' {
        errorStrategy = { task.exitStatus in [1, 143, 137, 104, 134, 139] ? 'retry' : 'finish' }
        maxRetries = 3
    }

    // ==========================================================================
    // PER-PROCESS RESOURCE OVERRIDES
    // ==========================================================================

    // antiSMASH — measured over 950 genomes (Erwiniaceae benchmark, 2026-06):
    // %cpu p50 = 117%, p99 = 145% (no task ever used 2 full cores) and peak RSS
    // p90 = 1.2 GB, p99 = 4.7 GB. The process_medium default (4 CPUs / 8 GB) was
    // ~4x over-allocated, which throttles how many genomes run concurrently.
    // 13/950 genomes exceeded 4 GB, so memory escalates once on an OOM kill before
    // falling back to the 'tolerant' behaviour of skipping the genome.
    // Exit 1 is in the retry list because of a startup race, not because antiSMASH
    // failing cleanly deserves a second go: on a fresh run Nextflow launches tasks
    // while conda is still materialising the env, and antiSMASH reads a half-written
    // HMM ("File exists, but appears to be empty?") and exits 1. Measured on the
    // 2026-09-07 Erwiniaceae run: 3 of 2,772 genomes lost this way, all within a
    // six-second window, every task afterwards fine. A genuinely broken genome costs
    // one extra attempt and is then skipped as before.
    withName: 'ANTISMASH' {
        cpus = 2
        // Required because executor.cpus is oversubscribed to 32 (see nextflow.config).
        // antiSMASH genuinely uses its cores -- measured %cpu p99 = 145% -- so without
        // this it would admit 16 tasks at 2 cpus against 16 real cores and thrash.
        // 7 x 2 = 14 cores, leaving headroom for the fetch tasks running alongside.
        maxForks = 7
        memory = { 6.GB * task.attempt }
        // Batched: params.antismash_batch_size genomes run sequentially in one task,
        // so the 2 h process_medium default no longer fits. At 50 genomes the mean is
        // ~35 min, but per-genome runtime spans 6.2x across size bins and the batch
        // is only as fast as its slowest members.
        time = '8h'
        maxRetries = 1
        errorStrategy = { task.exitStatus in [1, 104, 134, 137, 139, 140, 143] && task.attempt <= 1 ? 'retry' : 'ignore' }
    }

    // FETCH_RENAME_SCREEN — 1 CPU, not process_medium's 4. Measured on the GenBank
    // Enterobacterales run over 919 batches: mean %cpu 90.7, i.e. each task uses 0.91
    // of ONE core while reserving four. On a 16-core box that put the local executor
    // at exactly 4 concurrent tasks, so `download_max_forks` could not raise
    // concurrency no matter what it was set to -- the CPU budget was the real limit
    // and it was invisible, because nothing reports "you asked for 4x what you use".
    //
    // The task is about half network-wait, which consumes no CPU at all, so single-
    // core tasks overlap fetching against screening instead of blocking on a
    // reservation. Probed alongside the live run (bench/fork_probe.sh): aggregate
    // throughput went 11 -> 56 MB/s moving from 4 to 8 concurrent streams, with 0
    // failures in 102 batches, and 12 streams gained nothing further (55 MB/s) -- the
    // link saturates at ~55 MB/s. So concurrency is worth raising and the ceiling is
    // around 8-12 fetches, which is what download_max_forks = 12 targets.
    //
    // This makes the diamond screen single-threaded via `--threads ${task.cpus}`. It
    // costs 0.2 CPU-s per annotated genome and 2.0 on the blastx path, against ~32 s
    // of task wall time, so it is not the binding term.
    //
    // NOTE the one claim here that is NOT measured: CLAUDE.md records "concurrency
    // above 2 is worse, not better" from a probe on a throttled ~264 Mbit WiFi link.
    // That link no longer exists; this box measures 72.7 MB/s on 4 curl streams. The
    // old finding was never wrong, it was just about different hardware -- re-probe
    // before carrying either number to another machine.
    withName: 'FETCH_RENAME_SCREEN' {
        cpus = 1
        // 2 GB, not process_medium's 8. THIS was the real concurrency cap and it was
        // invisible: the local executor admits tasks while BOTH cpus and memory remain
        // free, so 56 GB / 8 GB held it at SEVEN concurrent tasks no matter what
        // download_max_forks said. Raising forks 4 -> 12 -> 24 moved the measured rate
        // 134 -> 194 genomes/min and then stopped, because 12 and 24 were both capped
        // at 7. Two tuning rounds were spent on the wrong parameter.
        //
        // Measured peak_rss over 1,603 tasks: p50 0.23 GB, p90 0.38, p99 0.94, max 1.20
        // -- 8.5x over-allocated at p99. 2 GB is 1.7x the observed maximum, which leaves
        // real headroom while allowing 28 concurrent.
        //
        // When overriding `cpus` on a label-derived process, check `memory` too. The
        // executor caps on whichever runs out first and reports neither.
        memory = '2 GB'
    }

    // BUILD_PROTEIN_POOL builds the pool's DIAMOND database as well as the pool, so it
    // needs more than process_low's 1 CPU / 2 GB. `diamond makedb` peaked at 1.65 GB
    // RSS on the whole-Bacteria pilot's 6.89 GB pool -- inside 2 GB, but only just, and
    // the pool grows with every retained genome. 4 CPUs because the wall time is paid
    // once per run and 16 threads cost 1.9x the CPU for 1.4x the speed (84 s / 268
    // CPU-s against 59 s / 500).
    // memory is declared in modules/genome/recover_orfs.nf, scaled to the genome
    // count -- a config withName closure cannot see process inputs, and setting
    // memory here would override it.
    withName: 'BUILD_PROTEIN_POOL' {
        cpus = 4
    }

    // RECOVER_ORFS needs longer than process_medium's 2h, which killed it at exactly
    // 00:53:30 -> 02:53:30 (exit 143, SIGTERM) on the whole-Bacteria reference pilot.
    // No OOM -- dmesg clean -- and the task was still progressing.
    //
    // CORRECTED 2026-10-19. This comment used to explain the cost as "the clade is
    // ~5 Mb genomes with decent annotation ... a taxonomically broad set has far more
    // unannotated CDS to call". That is backwards in both halves, and the measurement
    // behind it was taken on a failing USB disk. See
    // docs/comparisons/recover_orfs_recalibration/.
    //
    // The pool is built FROM the retained genomes, so GOOD annotation makes this stage
    // slower, not faster: GenBank Enterobacterales donated 769 proteins per retained
    // genome (64% of one batch had no annotation at all), the RefSeq reference pilot
    // 4,726. That is 2.74x the genomes but 16.8x the proteins, and 11.8x the per-genome
    // cost on identical input. Enterobacterales was cheap because its input was badly
    // annotated.
    //
    // Measured per genome against the pilot's pool: 100.5 s wall / 600.5 CPU-s with the
    // database rebuilt per genome, 46 s / 126 CPU-s with it prebuilt. At 200 genomes a
    // batch that is 5.6 h against 2.6 h -- so 2h was never going to fit either way, and
    // 12h holds with the fix in place.
    //
    // Overridden here rather than by raising process_medium globally, because 2h is a
    // correct and useful hang detector for its other members -- FETCH_RENAME_SCREEN
    // tasks run ~30-50 s, and the visualization steps are minutes. ANTISMASH already
    // carries its own 8h override for the same reason.
    //
    // Note RECOVER_ORFS has no retry label, so there was nothing to absorb the kill
    // even before Nextflow's IllegalThreadStateException race aborted the session.
    withName: 'RECOVER_ORFS' {
        time = '12h'

        // Memory is declared in modules/genome/recover_orfs.nf and scales with the
        // DIAMOND database, because a literal here would be tuned to one pool on one
        // machine. A config withName closure cannot see process inputs, so setting
        // memory here would override that closure -- hence only `time` lives here.
        //
        // What the measurement says, kept because the next person will want it:
        // diamond drives the peak and QUERY size drives diamond, not the database.
        // 0.35 MB of gaps peaks at 3.46 GB, 16 MB at 7.16, 64 MB at 7.26 -- so it
        // PLATEAUS, and a batch reaches the ceiling well before 50 genomes.
        //
        // Do NOT try to bound it by reshaping the query. Both levers were measured
        // and both CHANGE THE HITS: splitting the batch into 4 saves no memory at
        // all (7.16 GB, still past the plateau) while adding 106 hits and losing 47,
        // 78 of the additions above the script's 40% identity floor; `-b 0.02` does
        // cut memory to 0.33 GB but costs 5.5x the CPU and still moves the hit set.
        // One unsplit call is the only variant verified byte-identical to the
        // per-genome path.
    }
}
