params {
    // ╔═══════════════════════════════════════════════════════════════════════════╗
    // ║                         PIPELINE CONFIGURATION                            ║
    // ╠═══════════════════════════════════════════════════════════════════════════╣
    // ║  Workflow Structure:                                                      ║
    // ║                                                                           ║
    // ║  ┌─────────────────┐                                                      ║
    // ║  │ DOWNLOAD_GENOMES│ ─► Download & prepare genomes from NCBI              ║
    // ║  └────────┬────────┘                                                      ║
    // ║           │                                                               ║
    // ║           ▼                                                               ║
    // ║  ┌─────────────────┐                                                      ║
    // ║  │  BGC_ANALYSIS   │ ─► Main analysis workflow                            ║
    // ║  │  ┌─────────────┐│                                                      ║
    // ║  │  │ ANTISMASH   ││ ─► BGC detection (with optional reuse)               ║
    // ║  │  └─────────────┘│                                                      ║
    // ║  │  ┌─────────────┐│                                                      ║
    // ║  │  │ CLUSTERING  ││ ─► BiG-SCAPE GCF clustering                          ║
    // ║  │  └─────────────┘│                                                      ║
    // ║  │  ┌─────────────┐│                                                      ║
    // ║  │  │ PHYLOGENY   ││ ─► GTDB-Tk phylogenetic placement (with reuse)       ║
    // ║  │  └─────────────┘│                                                      ║
    // ║  │  ┌─────────────┐│                                                      ║
    // ║  │  │ VISUALIZE   ││ ─► Interactive HTML report generation                ║
    // ║  │  └─────────────┘│                                                      ║
    // ║  └─────────────────┘                                                      ║
    // ╚═══════════════════════════════════════════════════════════════════════════╝

    // ─── Global Pipeline Options ─────────────────────────────────────────────────
    // General settings that apply to the entire pipeline

    workflow = "full"       // Pipeline mode: "download", "bgc_analysis", or "full"
    outdir   = "results"    // Output directory for all results

    // How publishDir moves task output into outdir. 'link' makes hard links, so a
    // published file and its work/ counterpart share one inode: results/ costs no
    // extra disk, and the published copy survives `nextflow clean -f` (verified —
    // the inode's link count simply drops to 1). Measured on Erwiniaceae, copying
    // cost 26.25 MB/genome of pure duplication, ~25 TB at a million genomes.
    // Requires outdir and workDir on the same filesystem; set 'copy' if they are
    // not, or if anything edits published files in place, since a write through a
    // hard link also rewrites the cached task output and corrupts -resume.
    publish_mode = 'link'

    // ─── Reference database versions ────────────────────────────────────────
    // Pinned deliberately rather than tracking "latest". Every database uses
    // storeDir, which skips the download whenever its output path already
    // exists — so an unpinned URL does not track anything: it freezes whatever
    // was current on the day of the very first run and never re-checks, with no
    // record of what that was. This pipeline ran on a January taxdump for seven
    // months that way.
    //
    // Pinning makes the version a decision you can cite in a paper, and changing
    // a pin changes the storeDir output path, which is what triggers a fresh
    // download. Do not "upgrade" these casually: two runs on different database
    // versions are not directly comparable.
    gtdb_release  = '226'         // GTDB-Tk refuses data older than its own
                                  // MIN_REF_DATA_VERSION; 2.6.1 wants r226.
                                  // Bump the gtdbtk conda pin before bumping this.
    pfam_release  = '38.2'        // current as of 2026-08
    taxdump_date  = '2026-08-01'  // NCBI monthly archive; the live file changes daily

    // Warn (never fail) when a pinned database is behind what upstream offers.
    // One HEAD request per database at startup; set false for offline runs.
    check_db_updates = true

    // Genomes per task for the short per-genome steps (rename, GenBank→FASTA,
    // antiSMASH result copy). These take 0.2–1.5 s each, so one task per genome is
    // dominated by scheduler overhead; batching cuts job count by this factor.
    task_batch_size  = 100
    antismash_batch_size = 50   // see antismashBatchSize() in subworkflows/helpers.nf

    // ─── Download Genome Options ─────────────────────────────────────────────────
    // Download and prepare bacterial genomes from NCBI
    // Used by: --workflow download, --workflow full

    taxon = "Erwiniaceae"  // NCBI taxon (species, genus, family, order, etc.)

    // Restrict the NCBI download by assembly level, e.g. 'complete' or
    // 'chromosome,complete'. Null takes everything. Useful when taxonomic
    // breadth matters more than exhaustive coverage: Streptomyces has 16,030
    // GenBank genomes but 1,573 complete ones spanning 1,094 organism names,
    // which is a better diversity sample at a tenth of the compute.
    assembly_level = null

    // ─── antiSMASH Analysis Options ──────────────────────────────────────────────
    // BGC detection using antiSMASH
    // Used by: --workflow bgc_analysis, --workflow full
    
    input_genomes = null  // only for --workflow bgc_analysis; Path to pre-downloaded genomes directory
    reuse_antismash_from = null  // Taxon name to reuse antiSMASH results from, e.g. "Pantoea"
    antismash_minimal  = false  // antiSMASH minimal mode (faster, skips domain analysis)
    antismash_cb_general  = false  // only when antismash_minimal = false; ClusterBlast: Compare vs antiSMASH DB
    antismash_cc_mibig    = false  // only when antismash_minimal = false; ClusterCompare: Advanced MIBiG scoring
    antismash_smcog_trees = false  // only when antismash_minimal = false; Phylogenetic trees for BGC genes
    antismash_summary_gbk = false  // Write {genome}.gbk, the whole annotated genome (~11 MB each).
                                   // No pipeline step reads it; useful for eyeballing small sets,
                                   // costly at scale — 1,736 Pantoea genomes would add ~20 GB.

    // ─── Region Analysis Options ────────────────────────────────────────────────
    // BGC counting, tabulation, and statistics
    // Used by: --workflow bgc_analysis, --workflow full

    run_analysis     = true     // Enable region analysis and visualization
    count_per_contig = false    // Count per contig (true) or per genome (false)
    split_hybrids    = false    // Split hybrid types (T1PKS-NRPS → T1PKS + NRPS)
    skip_tree        = false    // Skip phylogenetic tree in HTML report visualization

    // ─── BiG-SCAPE Clustering Options ────────────────────────────────────────────
    // Gene Cluster Family (GCF) clustering with BiG-SCAPE
    // Used by: --workflow bgc_analysis, --workflow full

    clustering                 = "bigscape" // "none" or "bigscape"
    bigscape_cutoffs           = "0.30"     // GCF distance threshold(s), comma-separated
    bigscape_alignment_mode    = "auto"     // "auto", "global", or "glocal"
    bigscape_mibig_version     = ""         // MIBiG version (e.g., "3.1") or "" to exclude
    bigscape_classify          = "category" // "", "category", "class", or "legacy"
    bigscape_include_singletons = true      // Include unclustered BGCs
    bigscape_mix               = false      // Allow mixing BGC classes in same GCF

    // ─── BiG-SCAPE partitioning ─────────────────────────────────────────────
    // BiG-SCAPE compares every BGC against every other and its peak memory is
    // quadratic above ~4,000 BGCs (GB = 1.14 + 1.29e-7*n^2), reaching ~1.9 TB at
    // the 121,000 BGCs a million genomes would yield. Splitting the input by
    // pepM sequence identity first rebuilds the identical GCF network — verified
    // ARI 1.0000 against unpartitioned runs on Streptomyces, Erwiniaceae and a
    // combined set — with the largest job around 84 GB.
    //
    // Off by default: it has been validated at 185-518 BGCs, not at the scale
    // that needs it, and it has never run on SLURM. Turn it on deliberately.
    bigscape_partition = false

    // 0.60-0.80 is the verified safe window. Every same-GCF pair measured had
    // pepM identity >= 0.901, so 0.60 leaves wide margin; 0.90 demonstrably
    // splits real families (23 pairs, ARI 0.974). Failure is silent — a split
    // family looks like two families — so err low.
    bigscape_partition_identity = 0.60

    // Total BGCs in the run (not base pairs, and not a per-partition size) at
    // which partitioning starts paying. Below it everything goes in one
    // partition and the run behaves as if partitioning were off.
    //
    // Partitioning is a net LOSS at small scale: every partition re-pays
    // BiG-SCAPE's fixed Pfam-load cost. Measured on identical inputs,
    // 185 BGCs took 30 s as one job and 112 s across 19 (3.7x slower);
    // 518 BGCs took 93 s against 191 s (2.1x). The quadratic term only
    // overtakes that fixed cost around 10,000-12,000 BGCs.
    bigscape_partition_threshold = 10000

    // Largest partition allowed, as a BGC count. Leave at 0 to derive it from the
    // memory BIGSCAPE_PARTITION is allocated — the cap exists to avoid an OOM
    // kill, so it should follow the allocation rather than be guessed.
    //
    // This is a safety valve, NOT a tuning knob. To run smaller partitions,
    // lower the memory allocation: that moves the cap and the request together,
    // which is the honest lever. Set a number here only when the derivation is
    // wrong for your data — the fit was measured to 10,000 BGCs and is
    // extrapolated 3.1x at 128 GB, so BGCs with unusually rich domain content
    // could need more memory than it predicts.
    bigscape_partition_max_size = 0

    // Fraction of the allocation to budget when deriving the cap. Deliberately
    // under 1.0 because of that extrapolation: costs ~8% of the cap, buys ~19 GB
    // of headroom at 128 GB, against an OOM that discards hours of clustering.
    bigscape_partition_memory_margin = 0.85

    // ─── GTDB-TK Phylogeny Options ───────────────────────────────────────────────────────
    // Phylogenetic placement using GTDB-Tk
    // Used by: --workflow bgc_analysis, --workflow full
    // ⚠️  Requires ~140 GB disk space and ~56-64 GB RAM
    
    run_gtdbtk = true               // Enable phylogenetic analysis
    reuse_gtdbtk_from = null        // Taxon name to reuse GTDB-Tk results from
    gtdbtk_bgc_genomes_only = true  // Only analyze genomes with detected BGCs
    gtdbtk_cpus         = 8         // CPUs for identify/align steps
    gtdbtk_pplacer_cpus = 1         // CPUs for pplacer (keep low, memory-bound)
    gtdbtk_shard_size = 5000   // see gtdbtkShardSize() in subworkflows/helpers.nf
    gtdbtk_min_perc_aa = 10         // Minimum % amino acids in MSA
    gtdbtk_outgroup = "g__Escherichia" // Outgroup pattern for tree rooting (e.g., "g__Escherichia")
}

// =============================================================================
// CONFIGURATION PROFILES
// =============================================================================
// Use profiles with: nextflow run main.nf -profile <profile_name>

// Run reports live under a per-taxon directory. trace/report/timeline all set
// overwrite = true, so with a single shared path any later run — including a
// `-preview`, which writes them while executing nothing — destroyed the previous
// run's benchmark data. Scoping by taxon means analysing a new taxon no longer
// clobbers the last one. Defined once here and referenced by both the report
// scopes below and subworkflows/bgc_analysis.nf, so the two cannot drift.
// (Utils.sanitizeTaxon is not callable from config scope — lib/ loads for the
// workflow, not the config — hence the inline transform.)
params.pipeline_info_dir = "${params.outdir}/pipeline_info/" +
    params.taxon.replaceAll(/[^a-zA-Z0-9_]/, '_').replaceAll(/_+/, '_').replaceAll(/^_|_$/, '')

// Base process configuration. Included BEFORE `profiles` so that a profile's
// withLabel overrides actually win — Nextflow applies config in file order, so
// while these sat below the profiles block they silently overwrote every
// profile-level withLabel setting (the slurm profile's GTDB-Tk memory among them).
includeConfig 'conf/conda.config'
includeConfig 'conf/labels.config'

profiles {
    // Local execution profile - reduced memory for workstations
    local {
        executor.name = 'local'

        process {
            // Override high memory requirement for local execution
            // GTDB-Tk can run with less RAM but will be slower
            withLabel: 'process_high_memory' {
                memory = '48 GB'
            }

            // Reduce other high-memory processes for local
            withLabel: 'process_high' {
                memory = '16 GB'
            }
        }
    }

    // SLURM cluster profile - optimized based on benchmark (1,476 Pantoea genomes)
    // Uses labels from conf/labels.config with SLURM-specific overrides
    slurm {
        executor {
            name = 'slurm'
            queueSize = 200           // Max concurrent jobs
            submitRateLimit = '20/1min'
        }

        process {
            executor = 'slurm'
            queue = 'normal'

            // SLURM-specific overrides for labeled processes
            // These augment the defaults from conf/labels.config

            // High memory processes go to the high-memory queue. GTDB-Tk is the
            // only process carrying this label.
            //
            // 128 GB is a deliberate over-request, not a measurement. What we
            // actually measured locally argues the working set is far smaller:
            // Nextflow reports peak_rss ~104 GB, but that is summed across the
            // parallel identify/align children, which share memory-mapped
            // reference data, so shared pages are counted once per process. It
            // read 104.5 GB on 192 query genomes and 103.8 GB on 285 — runtime
            // scaled 1.5x while "peak memory" did not move, which a real working
            // set would not do. Both runs completed on a 56 GB box with available
            // memory never below ~54 GB and swap untouched, and 104 GB of unique
            // RSS is not physically possible there.
            //
            // We request 128 GB anyway because the failure modes are asymmetric:
            // an OOM kill loses a ~90 minute task and its queue slot, while the
            // over-request costs cents. Under the campus formula
            // max(cores x $1.19, GB x $0.08) per day, 8 cores x 128 GB tips the
            // billed dimension from cores ($9.52/day) to memory ($10.24/day) —
            // about $0.05 on a 1.5 hour classify step.
            //
            // Before trimming this, measure on the cluster with `sacct -o MaxRSS`,
            // which reports per-step RSS rather than Nextflow's summed figure.
            withLabel: 'process_high_memory' {
                queue = 'highmem'
                memory = '128 GB'
            }

            // BiG-SCAPE needs more memory on cluster (scales O(n^2))
            withName: 'BIGSCAPE' {
                memory = '64 GB'
            }

            // Visualization needs more memory for large trees
            withName: 'VISUALIZE_RESULTS' {
                memory = '16 GB'
                time = '4h'
            }

            // Database downloads need longer time
            withName: 'DOWNLOAD_GTDBTK_DB' {
                time = '12h'
            }

            // Network-bound processes
            withName: 'NCBI_DATASETS_DOWNLOAD' {
                time = '4h'
            }
        }

        // Conda settings for cluster
        conda.enabled = true
    }
}

// Essential nextflow run parameters, do not modify
// ansi colouring is enabled by default in Nextflow 26+
conda {
    enabled = true
    channels = ['conda-forge', 'bioconda', 'defaults']
}

// Include centralized configuration files

// Resource tracking - generates trace file for memory/CPU analysis
trace {
    enabled = true
    file = "${params.pipeline_info_dir}/pipeline_trace.tsv"
    fields = 'task_id,hash,name,status,exit,submit,start,complete,realtime,cpus,memory,peak_rss,peak_vmem,%cpu,%mem,rchar,wchar'
    overwrite = true
}

// Pipeline execution reports
report {
    enabled = true
    file = "${params.pipeline_info_dir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.pipeline_info_dir}/pipeline_timeline.html"
    overwrite = true
}