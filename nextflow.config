// Parameter validation, nf-core style: every param is declared in
// nextflow_schema.json, and main.nf calls validateParameters() so an undeclared
// param (a typo like --taxn) or a wrongly typed one stops the run instead of
// silently taking the default.
plugins {
    id 'nf-schema@2.5.1'
}


params {
    // One line per parameter, deliberately. That line is the prompt
    // scripts/configure_run.py shows and the text `--help` prints, so the
    // measurements and retractions behind each default live in
    // docs/parameters.md instead -- keyed by parameter name, and checked
    // against these values by tests/check_parameter_docs.py.

    // ─── Global Pipeline Options ─────────────────────────────────────────────────

    workflow = "full"  // Pipeline mode: "download", "bgc_analysis", or "full"
    outdir   = "results"  // Output directory for all results

    publish_mode = 'link'  // How output reaches outdir: 'link' hard-links (no extra disk), 'copy' for a separate filesystem.

    // ─── Reference database versions ────────────────────────────────────────
    gtdb_release  = '226'  // GTDB-Tk refuses reference data older than its own MIN_REF_DATA_VERSION.
    pfam_release  = '38.2'  // current as of 2026-08
    taxdump_date  = '2026-08-01'  // NCBI monthly archive; the live file changes daily

    check_db_updates = true  // Warn when a pinned database is behind upstream. Set false for offline runs.

    // ─── Task batching ───────────────────────────────────────────────────────────
    task_batch_size  = 100  // Genomes per task for the short per-genome steps, to cut scheduler overhead.
    antismash_batch_size = 50  // see antismashBatchSize() in subworkflows/helpers.nf

    // ─── pepM pre-screen ─────────────────────────────────────────────────────────
    pepm_prescreen             = true  // Skip antiSMASH on genomes with no PEP mutase, which cannot carry a phosphonate BGC.
    pepm_prescreen_bitscore    = 100  // 298/298 sensitivity; TPs score 154-552, background <= 51
    pepm_prescreen_min_density = 500  // proteins/Mb below which a genome is screened by DNA
    pepm_prescreen_batch_size  = 200  // see pepmBatchSize() in subworkflows/helpers.nf

    // ─── Download Genome Options ─────────────────────────────────────────────────

    taxon = "Erwiniaceae"  // NCBI taxon (species, genus, family, order, etc.)

    assembly_level = null  // Restrict the NCBI download by assembly level, e.g. 'complete'. Null takes everything.

    assembly_source = 'GenBank'  // 'GenBank' (GCA_) or 'RefSeq' (GCF_), case-insensitive.

    assembly_reference_only = false  // Restrict to NCBI's designated REFERENCE genome per species.

    metadata_shard_threshold  = 100000  // Above this many records, the metadata fetch is split by release date. 0 disables.
    download_batch_size = 25  // Accessions fetched per download task. Larger archives fail more often at NCBI.

    download_max_forks = 4  // Concurrent genome-fetch tasks. Link-limited, and batches start failing above 4.

    // ─── antiSMASH Analysis Options ──────────────────────────────────────────────

    input_genomes = null  // only for --workflow bgc_analysis; Path to pre-downloaded genomes directory
    reuse_antismash_from = null  // Taxon name to reuse antiSMASH results from, e.g. "Pantoea"
    antismash_minimal  = false  // antiSMASH minimal mode (faster, skips domain analysis)
    antismash_cb_general  = false  // only when antismash_minimal = false; ClusterBlast: Compare vs antiSMASH DB
    antismash_cc_mibig    = false  // only when antismash_minimal = false; ClusterCompare: Advanced MIBiG scoring
    antismash_smcog_trees = false  // only when antismash_minimal = false; Phylogenetic trees for BGC genes
    antismash_summary_gbk = false  // Write {genome}.gbk, the whole annotated genome (~11 MB each).
    antismash_html        = true  // Keep antiSMASH's per-genome HTML viewer. ~1.13 MB per genome; set false at scale.

    antismash_phosphonate_neighbourhood = 10  // Flank kept around a phosphonate rule core, in kb. Null uses antiSMASH's own 5.

    // ─── Region Analysis Options ────────────────────────────────────────────────

    run_analysis     = true  // Enable region analysis and visualization
    count_per_contig = false  // Count per contig (true) or per genome (false)
    split_hybrids    = false  // Split hybrid types (T1PKS-NRPS → T1PKS + NRPS)
    skip_tree        = false  // Skip phylogenetic tree in HTML report visualization

    // ─── BiG-SCAPE Clustering Options ────────────────────────────────────────────

    clustering                 = "bigscape"  // "none" or "bigscape"
    bigscape_cutoffs           = "0.30"  // GCF distance threshold(s), comma-separated

    bigscape_min_bgc_length = 2000  // Exclude region records shorter than this (bp) from clustering.
    bigscape_alignment_mode    = "auto"  // "auto", "global", or "glocal"
    bigscape_mibig_version     = ""  // MIBiG version (e.g. "4.0") to add to the distance matrix, or "" to exclude.

    bigscape_reference_dir     = "${projectDir}/assets/phosphonate_reference_bgcs"  // Characterised phosphonate clusters MIBiG does not carry. Set "" to disable.
    bigscape_classify          = "category"  // "", "category", "class", or "legacy"
    bigscape_include_singletons = true  // Include unclustered BGCs
    bigscape_mix               = false  // Allow mixing BGC classes in same GCF

    // ─── BiG-SCAPE partitioning ─────────────────────────────────────────────
    bigscape_partition = false  // Split BiG-SCAPE input by pepM identity first, for runs too large to cluster in one pass.

    bigscape_partition_identity = 0.60  // pepM identity threshold for partitioning. 0.60-0.80 is the verified safe window.

    bigscape_partition_threshold = 10000  // Total BGCs at which partitioning starts paying, not a per-partition size.

    bigscape_partition_max_size = 0  // Largest partition, in BGCs. 0 derives it from the task's memory allocation.

    bigscape_partition_memory_margin = 0.85  // Fraction of the allocation to budget when deriving the partition cap.

    // ─── Missing-gene recovery ──────────────────────────────────────────────
    recover_orfs = true  // Call genes antiSMASH would miss: it runs its own finder only on records with zero CDS.

    // ─── Within-GCF annotation transfer ─────────────────────────────────────
    annotation_transfer = true  // Propagate a product found on any GCF member to its orthologues, with provenance.
    transfer_min_identity = 50.0  // percent identity floor
    transfer_min_coverage = 0.70  // mutual alignment coverage, both directions

    // ─── GTDB-Tk Phylogeny Options ───────────────────────────────────────────────────────

    run_gtdbtk = true  // Enable phylogenetic analysis
    reuse_gtdbtk_from = null  // Taxon name to reuse GTDB-Tk results from
    gtdbtk_bgc_genomes_only = true  // Only analyze genomes with detected BGCs
    gtdbtk_cpus         = 8  // CPUs for identify/align steps
    gtdbtk_pplacer_cpus = 1  // CPUs for pplacer (keep low, memory-bound)
    gtdbtk_shard_size = 5000  // see gtdbtkShardSize() in subworkflows/helpers.nf
    gtdbtk_min_perc_aa = 10  // Minimum % amino acids in MSA

    gtdbtk_skip_ani_screen = false  // Send every genome through the full GTDB-Tk path, skipping its ANI pre-screen.
    gtdbtk_outgroup = "g__Escherichia"  // Outgroup pattern for tree rooting (e.g., "g__Escherichia")
}

// =============================================================================
// CONFIGURATION PROFILES
// =============================================================================
// Use profiles with: nextflow run main.nf -profile <profile_name>

// Run reports live under a per-taxon, per-RUN directory. trace/report/timeline all
// set overwrite = true, so with a single shared path any later run — including a
// `-preview`, which writes them while executing nothing — destroyed the previous
// run's benchmark data. Scoping by taxon stopped a NEW taxon clobbering the last
// one; it did nothing for the common case of running the same taxon twice, which
// is exactly what comparing two runs means. On 2026-11-03 two previews erased the
// Erwiniaceae regression gate's trace, report and timeline an hour after it
// finished, and left the trace as a bare header.
//
// `overwrite = false` is NOT the fix. Measured on 26.10.5: it preserves the old
// file and writes NOTHING for the new run — zero rows, no rotated copy — while the
// run still reports [SUCCESS]. It changes which run you lose, silently.
//
// The timestamp is inlined here, in ONE place, rather than held in a parameter of
// its own: `new Date()` evaluated twice would give two directories in one run, and
// nextflow_schema.json sets additionalProperties = false, so a `run_stamp` param
// would have to be declared and documented to pass validateParameters(). Verified
// on 26.10.5 that all three observers and a workflow-body read of this value land
// in the same directory, so one evaluation is what happens.
//
// Nextflow 26's strict config DSL allows this only as a bare expression: a
// `def stamp = ...` statement is rejected ("Variable declarations cannot be mixed
// with config statements") and `workflow.runName` is not defined in config scope.
//
// UTC, via java.time, for two reasons. This box runs America/Chicago, and across
// the DST fall-back the local clock repeats 01:00:00–01:59:59 — an hour in which
// two runs an hour apart would collide on one directory and interleave their
// traces. It also avoids `Date.format(String)`, which lives in groovy-dateutil
// rather than groovy-core since Groovy 2.5 and so is not guaranteed present.
//
// Known limit: two runs of the SAME taxon into the SAME outdir starting in the
// same second still share a directory. Nothing in the repo launches that way
// (submit_slurm.sh has no --array), so this is recorded rather than guarded.
//
// Defined once here and referenced by both the report scopes below and
// subworkflows/bgc_analysis.nf, so the two cannot drift.
// (Utils.sanitizeTaxon is not callable from config scope — lib/ loads for the
// workflow, not the config — hence the inline transform.)
params.pipeline_info_dir = "${params.outdir}/pipeline_info/" +
    params.taxon.replaceAll(/[^a-zA-Z0-9_]/, '_').replaceAll(/_+/, '_').replaceAll(/^_|_$/, '') +
    '/' + java.time.format.DateTimeFormatter.ofPattern('yyyyMMdd_HHmmss')
              .withZone(java.time.ZoneOffset.UTC).format(java.time.Instant.now())

// Base process configuration. Included BEFORE `profiles` so that a profile's
// withLabel overrides actually win — Nextflow applies config in file order, so
// while these sat below the profiles block they silently overwrote every
// profile-level withLabel setting (the slurm profile's GTDB-Tk memory among them).
includeConfig 'conf/conda.config'
includeConfig 'conf/labels.config'

profiles {
    // Local execution profile.
    //
    // THESE ARE THE PORTABLE FLOOR, not this workstation's numbers. Every value
    // here fits the smallest supported machine -- 16 GB RAM / 4 cores -- because
    // Nextflow's local executor refuses to ADMIT a task whose request exceeds the
    // machine, and the failure is not a slow run but a dead one:
    //
    //     Process requirement exceeds available memory -- req: 48 GB; avail: 12 GB
    //     [FAILED] completed=0 failed=0 cached=0
    //
    // (Measured 2026-11-02 against a stub process on a 12 GB executor.) The old
    // `process_high_memory = '48 GB'` therefore meant `-profile local` SILENTLY
    // REQUIRED a >=48 GB box; it did not run slowly on a laptop, it died.
    //
    // To use a bigger machine fully, generate a sizing override:
    //
    //     python scripts/check_machine.py            # writes machine.config
    //     nextflow run main.nf -profile local -c machine.config -params-file ...
    //
    // `scripts/configure_run.py` does this for you. A `-c` file wins over the
    // profile regardless of profile order (verified 2026-11-02: load order, not
    // profile order, decides), so machine.config overriding `local` is enough.
    //
    // Sizing lives in that script rather than here because Nextflow 26's config
    // parser is a STRICT DSL: `def` is rejected anywhere in nextflow.config
    // ("Variable declarations cannot be mixed with config statements", verified on
    // 26.04.3 at line 1), and lib/*.groovy is not on the classpath while the config
    // is parsed ("Sizing is not defined"). Only bare expressions survive, which is
    // why `executor.cpus` below can be derived here but the memory budgets cannot.
    local {
        executor.name = 'local'

        // Deliberate 2x CPU oversubscription -- see the rationale at the
        // `executor` block further down. A RATIO, not the absolute 32 this used to
        // inherit: 32 on a 4-core laptop is an 8x oversubscription that thrashes,
        // and the cpus admission check cannot catch it (verified 2026-11-02: an
        // 8-cpu request against 4 real cores is refused at `executor.cpus = 4`
        // and admitted at 32).
        executor.cpus = Runtime.runtime.availableProcessors() * 2

        process {
            // GTDB-Tk. The 48 GB this used to request was never a measurement.
            // The RefSeq Enterobacterales run sampled free(1) every 60 s for 2,608
            // samples; across the whole 3.6 h GTDB-Tk window (t=39.17->42.80 h,
            // 206 samples) mem_used peaked at 4 GB and MemAvailable never fell
            // below 51 GB of 56. What GTDB-Tk actually consumed was 150 GB of WORK
            // DISK -- disk gates this stage, not RAM. 12 GB is 3x the sampled peak
            // and fits a 16 GB machine.
            // See docs/comparisons/enterobacterales_refseq/disk_samples.tsv.
            withLabel: 'process_high_memory' {
                memory = '12 GB'
            }

            // BiG-SCAPE, whose peak is quadratic above ~4,000 BGCs:
            // GB = 1.80 + 2.04e-7*n^2 on the tree-PSS basis. 12 GB at the 0.85
            // partition margin caps one job at ~6,400 BGCs, which covers both
            // target taxa (Enterobacterales GenBank yielded 1,476 BGCs;
            // Actinomycetes projects to 1,000-4,000). machine.config raises this
            // to 16 GB on a box that has it, restoring the published 8,350 cap.
            withLabel: 'process_high' {
                memory = '12 GB'
            }

            // 8 GB is this box's figure; 6 GB is the floor-safe one. antiSMASH is
            // the only member that needs real memory and it carries its own
            // override below.
            withLabel: 'process_medium' {
                memory = '6 GB'
            }

            // (cores - 2) / 2 reproduces the measured 7 on a 16-core box exactly --
            // `.intdiv()` rather than an `(int)` cast because the strict config DSL
            // rejects C-style casts ("Unable to parse config file", no line number).
            // "7 x 2 = 14 cores, leaving headroom for the fetch tasks running
            // alongside" -- and gives 1 on a 4-core laptop instead of 7.
            withName: 'ANTISMASH' {
                maxForks = Math.max(1, (Runtime.runtime.availableProcessors() - 2).intdiv(2))
            }
        }
    }

    // SLURM cluster profile - optimized based on benchmark (1,476 Pantoea genomes)
    // Uses labels from conf/labels.config with SLURM-specific overrides
    slurm {
        executor {
            name = 'slurm'
            queueSize = 200           // Max concurrent jobs
            submitRateLimit = '20/1min'
        }

        process {
            executor = 'slurm'
            queue = 'normal'

            // SLURM-specific overrides for labeled processes
            // These augment the defaults from conf/labels.config

            // High memory processes go to the high-memory queue. GTDB-Tk is the
            // only process carrying this label.
            //
            // 128 GB is a deliberate over-request, not a measurement. What we
            // actually measured locally argues the working set is far smaller:
            // Nextflow reports peak_rss ~104 GB, but that is summed across the
            // parallel identify/align children, which share memory-mapped
            // reference data, so shared pages are counted once per process. It
            // read 104.5 GB on 192 query genomes and 103.8 GB on 285 — runtime
            // scaled 1.5x while "peak memory" did not move, which a real working
            // set would not do. Both runs completed on a 56 GB box with available
            // memory never below ~54 GB and swap untouched, and 104 GB of unique
            // RSS is not physically possible there.
            //
            // We request 128 GB anyway because the failure modes are asymmetric:
            // an OOM kill loses a ~90 minute task and its queue slot, while the
            // over-request costs cents. Under the campus formula
            // max(cores x $1.19, GB x $0.08) per day, 8 cores x 128 GB tips the
            // billed dimension from cores ($9.52/day) to memory ($10.24/day) —
            // about $0.05 on a 1.5 hour classify step.
            //
            // Before trimming this, measure on the cluster with `sacct -o MaxRSS`,
            // which reports per-step RSS rather than Nextflow's summed figure.
            withLabel: 'process_high_memory' {
                queue = 'highmem'
                memory = '128 GB'
            }

            // Restores what conf/labels.config declared before 2026-11-02, when
            // these defaults were lowered to be portable: they are the NO-PROFILE
            // layer, and a 32/48 GB default meant a laptop could not admit the
            // task at all. A cluster is not a laptop, so the cluster says so here
            // rather than making every other machine carry its numbers.
            //
            // This matters most for PARTITION_BGCS, whose partition cap is derived
            // from its own allocation: 11,158 BGCs at 32 GB against 6,416 at 12.
            // Without this line the cluster would silently partition finer.
            withLabel: 'process_high' {
                memory = '32 GB'
            }
            withLabel: 'process_medium' {
                memory = '8 GB'
            }

            // BiG-SCAPE needs more memory on cluster (scales O(n^2)). withName
            // beats withLabel, so this still wins over the 32 GB above.
            withName: 'BIGSCAPE' {
                memory = '64 GB'
            }

            // Visualization needs more memory for large trees
            withName: 'VISUALIZE_RESULTS' {
                memory = '16 GB'
                time = '4h'
            }

            // Database downloads need longer time
            withName: 'DOWNLOAD_GTDBTK_DB' {
                time = '12h'
            }

        }

        // Conda settings for cluster
        conda.enabled = true
    }
}

// Essential nextflow run parameters, do not modify
// ansi colouring is enabled by default in Nextflow 26+
conda {
    enabled = true
    channels = ['conda-forge', 'bioconda', 'defaults']

    // Outside the work directory on purpose. Nextflow defaults to caching
    // environments under `-w`, so changing the work directory re-solves every one
    // of them -- which is how the sqlalchemy breakage above was introduced: the
    // same spec resolved to a different version months later. Keeping the cache in
    // one place means environments are solved once and reused across runs, work
    // directories and drives.
    //
    // Override with NXF_CONDA_CACHEDIR to share a cache between checkouts.
    cacheDir = System.getenv('NXF_CONDA_CACHEDIR') ?: "${System.getProperty('user.home')}/.clusterquest/conda"
}

// Include centralized configuration files

// Resource tracking - generates trace file for memory/CPU analysis
trace {
    enabled = true
    file = "${params.pipeline_info_dir}/pipeline_trace.tsv"
    fields = 'task_id,hash,name,status,exit,submit,start,complete,realtime,cpus,memory,peak_rss,peak_vmem,%cpu,%mem,rchar,wchar'
    overwrite = true
}

// Pipeline execution reports
report {
    enabled = true
    file = "${params.pipeline_info_dir}/pipeline_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.pipeline_info_dir}/pipeline_timeline.html"
    overwrite = true
}
// Deliberate CPU oversubscription for the local executor.
//
// Measured on the GenBank Enterobacterales run at 12 concurrent fetch tasks, with
// /proc/diskstats and the trace rather than inference: network ~11 MB/s of ~56
// available, disk 57.7% busy, CPU ~7 of 16 cores, memory 5 of 56 GB. NOTHING was
// saturated, which means FETCH_RENAME_SCREEN is latency-bound, not
// throughput-bound -- each task spends most of its ~53 s waiting in sequence on
// NCBI round trips, then `sync` (5.5 s of pure wait under load), then the
// corruption check, then diamond.
//
// The local executor admits tasks while free cpus remain, so with cpus=1 it stops
// at availableProcessors and `download_max_forks` above 16 does nothing. Raising
// this lets tasks that are merely WAITING overlap, which is the whole point: a
// blocked network read occupies no core.
//
// It is a real risk for CPU-BOUND processes, which is why ANTISMASH now carries an
// explicit maxForks -- without one it would admit 16 tasks at 2 cpus each against
// 16 real cores. Any process added here that genuinely burns its cores needs the
// same guard, or this setting will thrash it.
//
// Derived rather than the absolute 32 this used to be: the ratio is the measured
// finding, the 32 was this box's instance of it. `-profile local` sets the same
// thing; this covers a run given no profile at all.
executor {
    cpus = Runtime.runtime.availableProcessors() * 2
}
