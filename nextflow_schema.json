{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/alpole23/ClusterQuest/main/nextflow_schema.json",
    "title": "ClusterQuest pipeline parameters",
    "description": "Phosphonate BGC discovery and characterisation. Generated from nextflow.config by tests/check_schema.py --write; regenerate rather than hand-edit.",
    "type": "object",
    "properties": {
        "annotation_transfer": {
            "type": "boolean",
            "description": "Propagate a product found on any GCF member to its orthologues, with provenance.",
            "default": true,
            "x-group": "Within-GCF annotation transfer"
        },
        "antismash_batch_size": {
            "type": "integer",
            "description": "see antismashBatchSize() in subworkflows/helpers.nf",
            "default": 50,
            "x-group": "Task batching"
        },
        "antismash_cb_general": {
            "type": "boolean",
            "description": "only when antismash_minimal = false; ClusterBlast: Compare vs antiSMASH DB",
            "default": false,
            "x-group": "antiSMASH Analysis Options"
        },
        "antismash_cc_mibig": {
            "type": "boolean",
            "description": "only when antismash_minimal = false; ClusterCompare: Advanced MIBiG scoring",
            "default": false,
            "x-group": "antiSMASH Analysis Options"
        },
        "antismash_html": {
            "type": "boolean",
            "description": "Keep antiSMASH's per-genome HTML viewer. ~1.13 MB per genome; set false at scale.",
            "default": true,
            "x-group": "antiSMASH Analysis Options"
        },
        "antismash_minimal": {
            "type": "boolean",
            "description": "antiSMASH minimal mode (faster, skips domain analysis)",
            "default": false,
            "x-group": "antiSMASH Analysis Options"
        },
        "antismash_phosphonate_neighbourhood": {
            "type": [
                "integer",
                "null"
            ],
            "description": "Flank kept around a phosphonate rule core, in kb. Null uses antiSMASH's own 5.",
            "default": 10,
            "x-group": "antiSMASH Analysis Options"
        },
        "antismash_smcog_trees": {
            "type": "boolean",
            "description": "only when antismash_minimal = false; Phylogenetic trees for BGC genes",
            "default": false,
            "x-group": "antiSMASH Analysis Options"
        },
        "antismash_summary_gbk": {
            "type": "boolean",
            "description": "Write {genome}.gbk, the whole annotated genome (~11 MB each).",
            "default": false,
            "x-group": "antiSMASH Analysis Options"
        },
        "assembly_level": {
            "type": [
                "string",
                "null"
            ],
            "description": "Restrict the NCBI download by assembly level, e.g. 'complete'. Null takes everything.",
            "x-group": "Download Genome Options"
        },
        "assembly_reference_only": {
            "type": "boolean",
            "description": "Restrict to NCBI's designated REFERENCE genome per species.",
            "default": false,
            "x-group": "Download Genome Options"
        },
        "assembly_source": {
            "type": "string",
            "description": "'GenBank' (GCA_) or 'RefSeq' (GCF_), case-insensitive.",
            "default": "GenBank",
            "x-group": "Download Genome Options"
        },
        "bigscape_alignment_mode": {
            "type": "string",
            "description": "\"auto\", \"global\", or \"glocal\"",
            "default": "auto",
            "x-group": "BiG-SCAPE Clustering Options"
        },
        "bigscape_classify": {
            "type": "string",
            "description": "\"\", \"category\", \"class\", or \"legacy\"",
            "default": "category",
            "x-group": "BiG-SCAPE Clustering Options"
        },
        "bigscape_cutoffs": {
            "type": "string",
            "description": "GCF distance threshold(s), comma-separated",
            "default": "0.30",
            "x-group": "BiG-SCAPE Clustering Options"
        },
        "bigscape_include_singletons": {
            "type": "boolean",
            "description": "Include unclustered BGCs",
            "default": true,
            "x-group": "BiG-SCAPE Clustering Options"
        },
        "bigscape_mibig_version": {
            "type": "string",
            "description": "MIBiG version (e.g. \"4.0\") to add to the distance matrix, or \"\" to exclude.",
            "default": "",
            "x-group": "BiG-SCAPE Clustering Options"
        },
        "bigscape_min_bgc_length": {
            "type": "integer",
            "description": "Exclude region records shorter than this (bp) from clustering.",
            "default": 2000,
            "x-group": "BiG-SCAPE Clustering Options"
        },
        "bigscape_mix": {
            "type": "boolean",
            "description": "Allow mixing BGC classes in same GCF",
            "default": false,
            "x-group": "BiG-SCAPE Clustering Options"
        },
        "bigscape_partition": {
            "type": "boolean",
            "description": "Split BiG-SCAPE input by pepM identity first, for runs too large to cluster in one pass.",
            "default": false,
            "x-group": "BiG-SCAPE partitioning"
        },
        "bigscape_partition_identity": {
            "type": "number",
            "description": "pepM identity threshold for partitioning. 0.60-0.80 is the verified safe window.",
            "default": 0.6,
            "x-group": "BiG-SCAPE partitioning"
        },
        "bigscape_partition_max_size": {
            "type": "integer",
            "description": "Largest partition, in BGCs. 0 derives it from the task's memory allocation.",
            "default": 0,
            "x-group": "BiG-SCAPE partitioning"
        },
        "bigscape_partition_memory_margin": {
            "type": "number",
            "description": "Fraction of the allocation to budget when deriving the partition cap.",
            "default": 0.85,
            "x-group": "BiG-SCAPE partitioning"
        },
        "bigscape_partition_threshold": {
            "type": "integer",
            "description": "Total BGCs at which partitioning starts paying, not a per-partition size.",
            "default": 10000,
            "x-group": "BiG-SCAPE partitioning"
        },
        "bigscape_reference_dir": {
            "type": "string",
            "description": "Characterised phosphonate clusters MIBiG does not carry. Set \"\" to disable.",
            "default": "/home/alexp/pipeline/assets/phosphonate_reference_bgcs",
            "x-group": "BiG-SCAPE Clustering Options"
        },
        "check_db_updates": {
            "type": "boolean",
            "description": "Warn when a pinned database is behind upstream. Set false for offline runs.",
            "default": true,
            "x-group": "Reference database versions"
        },
        "clustering": {
            "type": "string",
            "description": "\"none\" or \"bigscape\"",
            "default": "bigscape",
            "x-group": "BiG-SCAPE Clustering Options"
        },
        "count_per_contig": {
            "type": "boolean",
            "description": "Count per contig (true) or per genome (false)",
            "default": false,
            "x-group": "Region Analysis Options"
        },
        "download_batch_size": {
            "type": "integer",
            "description": "Accessions fetched per download task. Larger archives fail more often at NCBI.",
            "default": 25,
            "x-group": "Download Genome Options"
        },
        "download_max_forks": {
            "type": "integer",
            "description": "Concurrent genome-fetch tasks. Link-limited, and batches start failing above 4.",
            "default": 4,
            "x-group": "Download Genome Options"
        },
        "gtdb_release": {
            "type": "string",
            "description": "GTDB-Tk refuses reference data older than its own MIN_REF_DATA_VERSION.",
            "default": "226",
            "x-group": "Reference database versions"
        },
        "gtdbtk_bgc_genomes_only": {
            "type": "boolean",
            "description": "Only analyze genomes with detected BGCs",
            "default": true,
            "x-group": "GTDB-Tk Phylogeny Options"
        },
        "gtdbtk_cpus": {
            "type": "integer",
            "description": "CPUs for identify/align steps",
            "default": 8,
            "x-group": "GTDB-Tk Phylogeny Options"
        },
        "gtdbtk_min_perc_aa": {
            "type": "integer",
            "description": "Minimum % amino acids in MSA",
            "default": 10,
            "x-group": "GTDB-Tk Phylogeny Options"
        },
        "gtdbtk_outgroup": {
            "type": "string",
            "description": "Outgroup pattern for tree rooting (e.g., \"g__Escherichia\")",
            "default": "g__Escherichia",
            "x-group": "GTDB-Tk Phylogeny Options"
        },
        "gtdbtk_pplacer_cpus": {
            "type": "integer",
            "description": "CPUs for pplacer (keep low, memory-bound)",
            "default": 1,
            "x-group": "GTDB-Tk Phylogeny Options"
        },
        "gtdbtk_shard_size": {
            "type": "integer",
            "description": "see gtdbtkShardSize() in subworkflows/helpers.nf",
            "default": 5000,
            "x-group": "GTDB-Tk Phylogeny Options"
        },
        "gtdbtk_skip_ani_screen": {
            "type": "boolean",
            "description": "Send every genome through the full GTDB-Tk path, skipping its ANI pre-screen.",
            "default": false,
            "x-group": "GTDB-Tk Phylogeny Options"
        },
        "input_genomes": {
            "type": [
                "string",
                "null"
            ],
            "description": "only for --workflow bgc_analysis; Path to pre-downloaded genomes directory",
            "x-group": "antiSMASH Analysis Options"
        },
        "metadata_shard_threshold": {
            "type": "integer",
            "description": "Above this many records, the metadata fetch is split by release date. 0 disables.",
            "default": 100000,
            "x-group": "Download Genome Options"
        },
        "outdir": {
            "type": "string",
            "description": "Output directory for all results",
            "default": "results",
            "x-group": "Global Pipeline Options"
        },
        "pepm_prescreen": {
            "type": "boolean",
            "description": "Skip antiSMASH on genomes with no PEP mutase, which cannot carry a phosphonate BGC.",
            "default": true,
            "x-group": "pepM pre-screen"
        },
        "pepm_prescreen_batch_size": {
            "type": "integer",
            "description": "see pepmBatchSize() in subworkflows/helpers.nf",
            "default": 200,
            "x-group": "pepM pre-screen"
        },
        "pepm_prescreen_bitscore": {
            "type": "integer",
            "description": "298/298 sensitivity; TPs score 154-552, background <= 51",
            "default": 100,
            "x-group": "pepM pre-screen"
        },
        "pepm_prescreen_min_density": {
            "type": "integer",
            "description": "proteins/Mb below which a genome is screened by DNA",
            "default": 500,
            "x-group": "pepM pre-screen"
        },
        "pfam_release": {
            "type": "string",
            "description": "current as of 2026-08",
            "default": "38.2",
            "x-group": "Reference database versions"
        },
        "pipeline_info_dir": {
            "type": "string",
            "description": "",
            "default": "results/pipeline_info/Erwiniaceae"
        },
        "publish_mode": {
            "type": "string",
            "description": "How output reaches outdir: 'link' hard-links (no extra disk), 'copy' for a separate filesystem.",
            "default": "link",
            "x-group": "Global Pipeline Options"
        },
        "recover_orfs": {
            "type": "boolean",
            "description": "Call genes antiSMASH would miss: it runs its own finder only on records with zero CDS.",
            "default": true,
            "x-group": "Missing-gene recovery"
        },
        "reuse_antismash_from": {
            "type": [
                "string",
                "null"
            ],
            "description": "Taxon name to reuse antiSMASH results from, e.g. \"Pantoea\"",
            "x-group": "antiSMASH Analysis Options"
        },
        "reuse_gtdbtk_from": {
            "type": [
                "string",
                "null"
            ],
            "description": "Taxon name to reuse GTDB-Tk results from",
            "x-group": "GTDB-Tk Phylogeny Options"
        },
        "run_analysis": {
            "type": "boolean",
            "description": "Enable region analysis and visualization",
            "default": true,
            "x-group": "Region Analysis Options"
        },
        "run_gtdbtk": {
            "type": "boolean",
            "description": "Enable phylogenetic analysis",
            "default": true,
            "x-group": "GTDB-Tk Phylogeny Options"
        },
        "skip_tree": {
            "type": "boolean",
            "description": "Skip phylogenetic tree in HTML report visualization",
            "default": false,
            "x-group": "Region Analysis Options"
        },
        "split_hybrids": {
            "type": "boolean",
            "description": "Split hybrid types (T1PKS-NRPS \u2192 T1PKS + NRPS)",
            "default": false,
            "x-group": "Region Analysis Options"
        },
        "task_batch_size": {
            "type": "integer",
            "description": "Genomes per task for the short per-genome steps, to cut scheduler overhead.",
            "default": 100,
            "x-group": "Task batching"
        },
        "taxdump_date": {
            "type": "string",
            "description": "NCBI monthly archive; the live file changes daily",
            "default": "2026-08-01",
            "x-group": "Reference database versions"
        },
        "taxon": {
            "type": "string",
            "description": "NCBI taxon (species, genus, family, order, etc.)",
            "default": "Erwiniaceae",
            "x-group": "Download Genome Options"
        },
        "transfer_min_coverage": {
            "type": "number",
            "description": "mutual alignment coverage, both directions",
            "default": 0.7,
            "x-group": "Within-GCF annotation transfer"
        },
        "transfer_min_identity": {
            "type": "number",
            "description": "percent identity floor",
            "default": 50.0,
            "x-group": "Within-GCF annotation transfer"
        },
        "workflow": {
            "type": "string",
            "description": "Pipeline mode: \"download\", \"bgc_analysis\", or \"full\"",
            "default": "full",
            "x-group": "Global Pipeline Options"
        }
    },
    "additionalProperties": false
}
